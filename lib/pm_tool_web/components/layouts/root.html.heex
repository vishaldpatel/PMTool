<!DOCTYPE html>
<html lang="en" class="[scrollbar-gutter:stable]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <title>Ok, Next! Get it done. One week at a time.</title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/app.js"}>
    </script>
  </head>
  <body class="bg-[#082f49] antialiased">
    <ul class="relative z-10 flex items-center gap-4 justify-start mx-2 mb-2">
      <%= if @current_user do %>
        <li class="text-[0.8125rem] leading-6 text-zinc-400">
          {@current_user.email}
        </li>
        <li>
          <.link
            href={~p"/tasks"}
            class="text-[0.8125rem] leading-6 text-zinc-400 font-semibold hover:text-zinc-500"
          >
            Tasks
          </.link>
        </li>
        <li>
          <.link
            href={~p"/users/settings"}
            class="text-[0.8125rem] leading-6 text-zinc-400 font-semibold hover:text-zinc-500"
          >
            Settings
          </.link>
        </li>
        <li>
          <.link
            href={~p"/users/log_out"}
            method="delete"
            class="text-[0.8125rem] leading-6 text-zinc-400 font-semibold hover:text-zinc-500"
          >
            Log out
          </.link>
        </li>
      <% else %>
        <li>
          <.link
            href={~p"/"}
            class="text-[0.8125rem] leading-6 text-zinc-400 font-semibold hover:text-zinc-500"
          >
            Home
          </.link>
        </li>
        <li :if={PmTool.Accounts.billing_enabled?()}>
          <.link
            href={~p"/pricing"}
            class="text-[0.8125rem] leading-6 text-zinc-400 font-semibold hover:text-zinc-500"
          >
            Pricing
          </.link>
        </li>
        <li>
          <.link
            href={~p"/users/register"}
            class="text-[0.8125rem] leading-6 text-zinc-400 font-semibold hover:text-zinc-500"
          >
            Register
          </.link>
        </li>
        <li>
          <.link
            href={~p"/users/log_in"}
            class="text-[0.8125rem] leading-6 text-zinc-400 font-semibold hover:text-zinc-500"
          >
            Log in
          </.link>
        </li>
      <% end %>
    </ul>
    {@inner_content}
  </body>
</html>
