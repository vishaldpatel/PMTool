<.header>
  <%= @project.name %> Project Settings
</.header>
<.link
  class="text-red-500 hover:text-red-600 float-right"
  phx-click={JS.push("delete", value: %{combo_slug: "#{Project.get_combo_slug(@project)}"}) |> hide("##{@project.id}")}
  data-confirm="Are you sure?"
>
  Delete Project
</.link>

<.live_component
  module={PmToolWeb.ProjectLive.FormComponent}
  id={@project.id}
  title={@page_title}
  action={@live_action}
  project={@project}
  patch={~p"/projects/#{@project}"}
/>
<.back class="float-left" navigate={~p"/projects/#{@project}"}>Back</.back>
