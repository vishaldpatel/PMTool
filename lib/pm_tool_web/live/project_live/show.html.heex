<.header>
  <%= @project.name %>:
  <:actions>
    <.link patch={~p"/projects/#{@project}/edit"} phx-click={JS.push_focus()}>
      <.button>Project Settings</.button>
    </.link>
  </:actions>
</.header>

<ul class="ml-5 list-disc">
  <%= for task <- @tasks do %>
    <li><%= task.name %></li>
  <% end %>
</ul>

<.back navigate={~p"/projects"}>Back to projects</.back>
